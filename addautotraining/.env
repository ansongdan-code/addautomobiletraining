# Production Environment Variables Template
# Copy this file to .env.production and update values

# Database Configuration - Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb://admin:strongpassword@mongo:27017/addautotraining?authSource=admin

# JWT Configuration - Generate a strong secret key
JWT_SECRET=your-production-jwt-secret-key-here-make-it-very-long-and-random
JWT_EXPIRE=24h

# PayPal Configuration - Use your live PayPal credentials for production
REACT_APP_PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_ID=your-paypal-client-id
PAYPAL_CLIENT_SECRET=your-paypal-client-secret

# Paystack Configuration (if using)
PAYSTACK_PUBLIC_KEY=your-paystack-public-key
PAYSTACK_SECRET_KEY=your-paystack-secret-key

# File Upload Configuration
MAX_FILE_SIZE=10000000

# Security Configuration
BCRYPT_SALT_ROUNDS=12
PASSWORD_MIN_LENGTH=6
MAX_LOGIN_ATTEMPTS=5
LOCK_TIME=7200000

# Environment
NODE_ENV=production
PORT=5000

# Frontend URL - Your Vercel deployment URL
FRONTEND_URL=https://your-app-name.vercel.app