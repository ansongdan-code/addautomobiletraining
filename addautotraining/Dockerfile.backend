FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install all dependencies (PayPal SDK is required)
RUN npm install --legacy-peer-deps

# Copy backend source code
COPY server.js ./
COPY docker-init.js ./
COPY models ./models
COPY routes ./routes
COPY middleware ./middleware
COPY api ./api
COPY uploads ./uploads

# Create uploads directory with proper permissions
RUN mkdir -p uploads && chmod 755 uploads

# Create a non-root user for improved container security
RUN addgroup -S app && adduser -S app -G app
RUN chown -R app:app /app
USER app

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/api/settings', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server with admin provisioning
CMD ["sh", "-c", "node docker-init.js && node server.js"]
