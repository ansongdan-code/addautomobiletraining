FROM node:20-alpine

WORKDIR /app

# Copy package files
COPY package*.json ./

# Install production dependencies only
ENV NODE_ENV=production
RUN npm ci --omit=dev --legacy-peer-deps

# Copy backend source code
COPY server.js ./
COPY docker-init.js ./
COPY models ./models
COPY routes ./routes
COPY controllers ./controllers
COPY services ./services
COPY docs ./docs
COPY utils ./utils
COPY middleware ./middleware
COPY api ./api
COPY uploads ./uploads
# Configure production logging defaults
ENV LOG_DIR=/app/logs
ENV LOG_LEVEL=info
ENV ENABLE_FILE_LOGGING=true

# Create runtime directories with proper permissions
RUN mkdir -p uploads logs && chmod -R 755 uploads logs

# Create a non-root user for improved container security
RUN addgroup -S app && adduser -S app -G app
RUN chown -R app:app /app
USER app

# Expose port
EXPOSE 5000

# Health check
HEALTHCHECK --interval=30s --timeout=3s --start-period=40s --retries=3 \
  CMD node -e "require('http').get('http://localhost:5000/api/settings', (r) => {process.exit(r.statusCode === 200 ? 0 : 1)})"

# Start server with admin provisioning
CMD ["sh", "-c", "node docker-init.js && node server.js"]
