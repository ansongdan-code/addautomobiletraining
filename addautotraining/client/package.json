  "scripts": {
    "start": "node server.js",
    "build": "echo 'This is a wrapper package. Run build from the root directory.'",
    "build:prod": "cross-env NODE_ENV=production npm run build",
    "test": "react-scripts test",
    "test:server": "jest",
    "test:all": "npm run test -- --watchAll=false && npm run test:server",
    "test:coverage": "jest --coverage && react-scripts test --coverage --watchAll=false",
    "test:watch": "jest --watch",
    "test:admin": "jest test/admin-login.test.js --testEnvironment=node",
    "lint": "eslint src/ --ext .js,.jsx",
    "lint:fix": "eslint src/ --ext .js,.jsx --fix",
    "start:prod": "cross-env NODE_ENV=production node server.js",
    "dev": "concurrently \"npm start\" \"react-scripts start\"",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "devDependencies": {
    "@babel/preset-env": "^7.28.0",
    "@babel/preset-react": "^7.27.1",
    "babel-jest": "^29.7.0",
    "concurrently": "^9.2.0",
    "cross-env": "^10.0.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "react-scripts": "^5.0.1",
    "supertest": "^7.1.4"
  }
